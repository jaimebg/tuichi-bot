# Copy this file to .env and fill in the secrets before running the bot.
TWITCH_BOT_USERNAME=jaimitadas_bot
TWITCH_CHANNEL=jaimevarecto
TWITCH_OAUTH_TOKEN=oauth:replace_with_token
# Optional: Only needed if you want the bot to auto-detect when you are live
TWITCH_CLIENT_ID=
TWITCH_APP_ACCESS_TOKEN=

# Optional configuration tweaks
TWITCH_GREETING_MESSAGES=Oop te pille conectada {user}, ponte comoda.|Venga guapa, te pille dentro {user}.|Eh {user}, sabia que aparecerias por aqui.|Buenas {user}, ya te estaba echando de menos.|{user}, mira quien llego; la fiesta empieza ahora.
TWITCH_GREETING_COOLDOWN=300
TWITCH_LIVE_CHECK_INTERVAL=60
TWITCH_BOT_LOG_LEVEL=INFO
