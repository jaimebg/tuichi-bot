# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# See "Obtaining credentials" in the README for how to get each token.
# Never commit .env -- it is gitignored.

# --- Required ---

# The account the bot posts as. Lowercased automatically; case does not matter.
TWITCH_USERNAME=your_bot_username

# The channel the bot joins. A leading '#' is stripped automatically.
TWITCH_CHANNEL=your_channel_name

# OAuth credentials for the bot account (Authorization Code flow).
# Scopes: chat:read chat:edit
TWITCH_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx

# From your app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# From https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: broadcaster token ---
# The CHANNEL OWNER's token, not the bot's. Enables EventSub channel-point
# redemptions, stream live/offline events, and presence-driven greetings and
# goodbyes. Without it those features are disabled gracefully -- the bot still
# runs, chats and plays games.
# Scopes: channel:read:redemptions channel:read:subscriptions moderator:read:chatters
#TWITCH_BROADCASTER_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx
#TWITCH_BROADCASTER_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: behaviour ---

# Extra usernames excluded from greetings, goodbyes, the inactivity shame
# message, presence events, and the habitual-users list in the stream-start
# announcement. Comma-separated. The bot already excludes itself, the channel
# owner, and common chat bots (streamelements, nightbot, streamlabs, moobot,
# fossabot) -- this only adds to that list.
# It does NOT stop those users' messages from being processed normally.
#EXCLUDED_USERS=somebot,anotherbot

# One of: debug, info, warn, error
LOG_LEVEL=info

# --- Optional: media overlay (OBS browser source) ---
MEDIA_OVERLAY_ENABLED=true
MEDIA_OVERLAY_PORT=8910

# --- Optional: health / metrics server ---
HEALTH_PORT=9090
# Required to reach /metrics, /api/users and /api/say. Without it those
# endpoints return 401 and only /health and /api/status are reachable.
#HEALTH_API_KEY=change-me-to-a-long-random-string
