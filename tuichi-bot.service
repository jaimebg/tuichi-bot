# tuichi-bot.service
# Copy to /etc/systemd/system/tuichi-bot.service
# Then: sudo systemctl daemon-reload && sudo systemctl enable tuichi-bot
[Unit]
Description=Tuichi Bot - Twitch Chat Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=ubuntu
WorkingDirectory=/home/ubuntu/tuichi-bot
ExecStart=/usr/bin/node --env-file=.env src/index.js
Restart=always
RestartSec=5
WatchdogSec=120
MemoryMax=768M
CPUQuota=80%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tuichi-bot

[Install]
WantedBy=multi-user.target
